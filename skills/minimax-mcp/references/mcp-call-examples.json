{
  "note": "完成 MCP initialize 握手后，将每个请求序列化为单行 JSON 发往 stdio。示例中的会话、问卷、消息 ID 请替换为实际返回值。",
  "examples": [
    {
      "intent": "检查运行状态和会话近况",
      "calls": [
        {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "minimax_status",
            "arguments": {}
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "tools/call",
          "params": {
            "name": "minimax_session",
            "arguments": {
              "perSession": 2,
              "limit": 3
            }
          }
        }
      ]
    },
    {
      "intent": "搜索会话并往前翻阅历史",
      "calls": [
        {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "tools/call",
          "params": {
            "name": "minimax_session",
            "arguments": {
              "query": "Blender 立冬",
              "limit": 5
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "tools/call",
          "params": {
            "name": "minimax_session",
            "arguments": {
              "sessionId": "mvs_example",
              "limit": 10
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 5,
          "method": "tools/call",
          "params": {
            "name": "minimax_session",
            "arguments": {
              "sessionId": "mvs_example",
              "before": 120,
              "limit": 10
            }
          }
        }
      ],
      "note": "before 使用上一页返回的 oldestId。"
    },
    {
      "intent": "只读预览原生 Agent 的发送计划",
      "calls": [
        {
          "jsonrpc": "2.0",
          "id": 6,
          "method": "tools/call",
          "params": {
            "name": "minimax_agent",
            "arguments": {
              "sessionId": "mvs_example",
              "message": "概括这轮测试的结果",
              "preview": true,
              "send": true
            }
          }
        }
      ]
    },
    {
      "intent": "授权后发送原生任务并查询本轮结果",
      "calls": [
        {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "tools/call",
          "params": {
            "name": "minimax_agent",
            "arguments": {
              "sessionId": "mvs_example",
              "message": "概括这轮测试的结果",
              "send": true
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 8,
          "method": "tools/call",
          "params": {
            "name": "minimax_agent",
            "arguments": {
              "action": "result",
              "sessionId": "mvs_example",
              "afterMessageId": 123
            }
          }
        }
      ],
      "note": "发送返回 sent:true、verified:true 后，用实际 messageId 替换 afterMessageId。若 sent:null，先读目标会话确认。"
    },
    {
      "intent": "查 Bot 名册和指定成员的对话",
      "calls": [
        {
          "jsonrpc": "2.0",
          "id": 9,
          "method": "tools/call",
          "params": {
            "name": "minimax_bot",
            "arguments": {}
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 10,
          "method": "tools/call",
          "params": {
            "name": "minimax_bot",
            "arguments": {
              "target": "剪辑师",
              "limit": 5
            }
          }
        }
      ]
    },
    {
      "intent": "激活 MiniMax 后停止已发送的这一轮",
      "calls": [
        {
          "jsonrpc": "2.0",
          "id": 14,
          "method": "tools/call",
          "params": {
            "name": "minimax_agent",
            "arguments": { "action": "activate" }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 15,
          "method": "tools/call",
          "params": {
            "name": "minimax_agent",
            "arguments": { "action": "stop", "sessionId": "mvs_example", "afterMessageId": 123 }
          }
        }
      ],
      "note": "afterMessageId 使用发送回执的 messageId。"
    },
    {
      "intent": "打开 Bot Studio 后读取实时对话",
      "calls": [
        {
          "jsonrpc": "2.0",
          "id": 16,
          "method": "tools/call",
          "params": {
            "name": "minimax_bot",
            "arguments": { "action": "open", "sessionId": "mvs_example" }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 17,
          "method": "tools/call",
          "params": {
            "name": "minimax_bot",
            "arguments": { "action": "read", "target": "bot:bot_example", "limit": 5 }
          }
        }
      ],
      "note": "新标签页需要 MiniMax 在前台。用 source:live 核对实时连接。"
    },
    {
      "intent": "查看待答问卷及推荐答案",
      "calls": [
        {
          "jsonrpc": "2.0",
          "id": 11,
          "method": "tools/call",
          "params": {
            "name": "minimax_questionnaire",
            "arguments": {}
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 12,
          "method": "tools/call",
          "params": {
            "name": "minimax_questionnaire",
            "arguments": {
              "requestId": "ask_example"
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 13,
          "method": "tools/call",
          "params": {
            "name": "minimax_questionnaire",
            "arguments": {
              "requestId": "ask_example",
              "selections": [
                {
                  "stepId": "step_example",
                  "optionIds": [
                    "option_example"
                  ]
                }
              ]
            }
          }
        }
      ],
      "note": "提交选项时在相同请求中加 preview:false 和 force:true。"
    }
  ]
}
