{
  "contractVersion": 1,
  "server": {
    "name": "minimax-mcp",
    "version": "0.1.0",
    "transport": "stdio",
    "declaredProtocolVersions": [
      "2024-11-05",
      "2025-03-26",
      "2025-06-18"
    ]
  },
  "reviewedAt": "2026-11-14",
  "sourceCommit": "ed3283266b32d395ed17282cc8b848a2d9ed9088",
  "scope": "Descriptive summary of current tools, NOT executable JSON Schema or a claim that known safety issues are fixed. Discover exact schema using tools/list; see mcp-surface.md for caller budgets and implementation gaps.",
  "tools": [
    {"name":"minimax_brief","intent":"注意力快照","input":{"limit":"integer 1..500; default 200","stalledMinutes":"integer >=1; default 10","activeMinutes":"integer >=1; default 10","finishedMinutes":"integer >=1; default 60"},"output":"headline/counts/items/taskFailures","sideEffects":"read"},
    {"name":"minimax_status","intent":"本地状态与可用时的额度快照","input":{},"output":"dbFound/sessions/messages/runningTasks; optional quota","sideEffects":"read"},
    {"name":"minimax_list_sessions","intent":"列出会话","input":{"limit":"integer 1..100; default 20"},"output":"sessions[]; index is unstable","sideEffects":"read"},
    {"name":"minimax_read_session","intent":"读取会话历史","input":{"session":"required string; sessionId alias","limit":"integer 1..200; default 30","includeThinking":"boolean; default false","before":"integer >=1; optional"},"output":"sessionId/returned/messages; pagination metadata","sideEffects":"read"},
    {"name":"minimax_tail_sessions","intent":"采样最近会话末尾","input":{"count":"integer 1..20; default 3","perSession":"integer 1..20; default 2"},"output":"sessions[]","sideEffects":"read"},
    {"name":"minimax_search","intent":"检索标题和消息","input":{"query":"required string; q alias","limit":"integer 1..100; default 10"},"output":"hits[]","sideEffects":"read"},
    {"name":"minimax_pending","intent":"读取待答问卷摘要","input":{},"output":"pending[]; data layer limit 50","sideEffects":"read"},
    {"name":"minimax_tasks","intent":"读取 MiniMax 后台任务","input":{"limit":"integer 1..100; default 20","status":"optional string"},"output":"tasks[]; not MCP tasks/*","sideEffects":"read"},
    {"name":"minimax_windows","intent":"读取窗口几何","input":{},"output":"onScreenCount/windows/hiddenOrOtherSpace","sideEffects":"read"},
    {"name":"minimax_activate","intent":"唤醒或激活应用","input":{},"output":"driver-dependent activation result","sideEffects":"window/focus change; may launch app"},
    {"name":"minimax_screenshot","intent":"获取截图文件","input":{"mode":"screen|region; default screen","name":"string; default minimax","x/y/width/height":"optional number fields; region coordinates"},"output":"driver-dependent screenshot paths","sideEffects":"writes screenshot file"},
    {"name":"minimax_send_message","intent":"当前视图输入或发送","input":{"message":"required string; text/content aliases","send":"boolean; default false","preview":"boolean; default false","force":"boolean; default false","quietSeconds":"integer >=0; default 300","layout":"chat|newtask; default chat","at":"optional string x,y"},"output":"preview or sent/verified/sessionId/messageId/warning","sideEffects":"preview prevents input; send=false still modifies editor; no sessionId input"},
    {"name":"minimax_click","intent":"坐标点击","input":{"x":"required number","y":"required number","button":"left|right; default left"},"output":"driver-dependent clicked/at","sideEffects":"click may commit; coordinate space differs by driver"},
    {"name":"minimax_type","intent":"输入文本","input":{"text":"required string","force":"boolean; default false"},"output":"typed; CDP may include currentText","sideEffects":"changes editor"},
    {"name":"minimax_key","intent":"按键或快捷键","input":{"key":"required string","modifiers":"string array; default []"},"output":"driver-dependent key result","sideEffects":"key may commit"},
    {"name":"minimax_get_result","intent":"读取或等待会话结果","input":{"sessionId":"optional string; session alias","sinceMessageId":"optional integer >=1; KNOWN BUG: ignored by handler","timeoutSeconds":"integer 0..300; default 0"},"output":"done/sessionId/result/status; handler reads unexposed afterMessageId","sideEffects":"read; do not claim round-bound verification"},
    {"name":"minimax_draft_answer","intent":"生成只读建议答案","input":{"requestId":"required string; id alias"},"output":"steps/suggestion; or already-answered status","sideEffects":"read; recommended else first-option heuristic"},
    {"name":"minimax_answer_question","intent":"预览或提交问卷","input":{"requestId":"required string; id alias","selections":"optional array; each item requires stepId:string and optionIds:string[]","preview":"boolean; default true","force":"boolean; default false","at":"optional string; currently not used by execution"},"output":"wouldSubmit/clickPlan or submitted/verified/status/clicked/missed","sideEffects":"preview prevents selection clicks; commit requires preview=false and force=true; region not accepted"},
    {"name":"minimax_new_task","intent":"尝试进入新建任务视图","input":{},"output":"opened/via; not reliable proof of a new session","sideEffects":"navigation/editor focus"},
    {"name":"minimax_open_session","intent":"尝试导航到会话","input":{"sessionId":"required string; session alias"},"output":"opened/sessionId/matchedText; not verified actual session","sideEffects":"navigation; at not accepted"},
    {"name":"minimax_stop_generation","intent":"停止当前视图任务","input":{"sessionId":"optional string; session alias; currently ignored","force":"boolean; default false"},"output":"stopped/via; no target identity verification","sideEffects":"stops current view, not verified requested session"},
    {"name":"minimax_watch","intent":"巡检并按策略尝试动作","input":{"action":"tick|status|reset|config; default tick","dryRun":"boolean; default false","policy":"object: mode=act, riskCeiling=low, minIdleSeconds=180, maxActionsPerTick=2, autoNudge enabled with 360min cooldown, allowSessions optional","stalledMinutes":"integer >=1; default 10","finishedMinutes":"integer >=1; default 60"},"output":"policy/counts/events/actions/needsHuman; action-dependent","sideEffects":"tick persists local state even dryRun; resume branch bypasses mode/allowlist/budget; explicit dryRun=true required for diagnosis"},
    {"name":"minimax_events","intent":"读取巡检事件","input":{"since":"optional string","limit":"integer 1..500; default 50"},"output":"events/count/total","sideEffects":"read"},
    {"name":"minimax_find_text","intent":"DOM/OCR 文本定位","input":{"text":"required string; query alias","mode":"contains|exact|prefix; default contains","index":"integer >=0; default 0","region":"optional object x/y/width/height required","refresh":"boolean; default true"},"output":"query/total/picked/matches; driver-dependent coordinates","sideEffects":"no click; CDP ignores mode/region and falls back for out-of-range index"},
    {"name":"minimax_click_text","intent":"DOM/OCR 文本点击","input":{"text":"required string; query alias","mode":"contains|exact|prefix; default contains","index":"integer >=0; default 0","region":"optional object x/y/width/height required"},"output":"driver-dependent clicked/at/tag","sideEffects":"may commit; CDP ignores mode/index/region"},
    {"name":"minimax_bot_message","intent":"Bot 团队读取或写入","input":{"chatId":"string with hardcoded runtime default; caller MUST set explicitly","action":"send|read|cancel|resume_pending; default send; caller MUST set explicitly","text":"optional string; required for send by handler","limit":"integer 1..100; default 20"},"output":"upstream Bot API response","sideEffects":"read only for action=read; other actions mutate"},
    {"name":"minimax_auto_resume","intent":"额度阻断会话恢复预览或执行","input":{"dryRun":"boolean; default true","limit":"integer 1..20; default 5","sessionId":"optional string"},"output":"quotaAvailable/quotaStatus/results; branch-dependent fields","sideEffects":"dryRun=false may resume; unknown quota currently fail-open"}
  ]
}
