{
  "manifest_version": "0.2",
  "name": "minimax-mcp",
  "version": "0.1.0",
  "description": "Local-first stdio MCP server and Agent Skill that lets AI agents read and operate MiniMax Code on the user's Mac.",
  "author": {
    "name": "Luckycat133"
  },
  "server": {
    "type": "stdio",
    "entry_point": "server/mcp-server.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/mcp-server.js"
      ],
      "env": {
        "MINIMAX_PYTHON": "python3",
        "MINIMAX_SQLITE_BIN": "sqlite3"
      }
    }
  },
  "user_config": {}
}
